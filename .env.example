# ════════════════════════════════════════════════════════════════════
#  Sandeshika configuration
#
#  Copy to `.env` and edit.  `.env` is gitignored; `.env.example` is the
#  committed contract.  Resolution order, highest wins:
#
#      1. Runtime override   (Settings screen -> DataStore)
#      2. Process env var    (CI: SANDESHIKA_MEDHA_PORT=9000 ./gradlew ...)
#      3. .env               (your machine)
#      4. .env.example       (this file — the default of record)
#
#  Anything a user might need to change AFTER install is also exposed in
#  the Settings screen.  Values marked [build] are baked in at compile
#  time and need a rebuild.
# ════════════════════════════════════════════════════════════════════

# ── Medha · on-device LLM substrate ─────────────────────────────────
# Must match the port shown in the Medha app. Medha binds loopback only.
MEDHA_HOST=127.0.0.1
MEDHA_PORT=8080
# Paste the token for the `sandeshika` client created in Medha's UI.
# Leave blank: the app will prompt and store it in EncryptedSharedPreferences.
# NEVER commit a real token — that is why .env is gitignored.
MEDHA_TOKEN=
MEDHA_CLIENT_ID=sandeshika
MEDHA_NAMESPACE=sms
# Master switch. false = pure deterministic mode, no inference at all.
MEDHA_ENABLED=true
MEDHA_HEALTH_POLL_SECONDS=60
MEDHA_CONNECT_TIMEOUT_SECONDS=5
# Generous: Medha's own hard ceiling is 120s per request.
MEDHA_READ_TIMEOUT_SECONDS=180
# Items per enrichment batch. Raise once /generate/batch lands in Medha.
MEDHA_BATCH_SIZE=12
# Backoff attempts on HTTP 429 (Medha queue full / thermally gated).
MEDHA_MAX_RETRIES=4
MEDHA_RETRY_BASE_SECONDS=8

# ── App identity [build] ────────────────────────────────────────────
APP_ID=com.adabala.sandeshika
APP_VERSION_NAME=0.1.0
APP_VERSION_CODE=1
APP_MIN_SDK=29
APP_TARGET_SDK=35

# ── Ingestion ───────────────────────────────────────────────────────
# Rows per ContentResolver page during backfill. Paged by TIMESTAMP,
# never by offset — messages arriving mid-scan shift every offset.
INGEST_BACKFILL_PAGE_SIZE=300
# 0 = ingest the entire inbox.
INGEST_BACKFILL_MAX_MESSAGES=0
# 0 = no cutoff. Set e.g. 1095 to ingest only the last 3 years.
INGEST_HISTORY_DAYS=0
# WorkManager floor is 15 min; smaller values are silently clamped.
INGEST_SWEEP_MINUTES=15
# ContentObserver fires several times per message; coalesce the burst.
INGEST_OBSERVER_DEBOUNCE_MS=1500

# ── Privacy ─────────────────────────────────────────────────────────
# Auth OTP bodies are purged after this many hours. Metadata is kept.
OTP_RETENTION_HOURS=24
# Delivery OTPs are exempt — they attach to an order and stay useful.
PROMO_RETENTION_DAYS=30
REQUIRE_BIOMETRIC=true
BIOMETRIC_TIMEOUT_MINUTES=5
# SQLCipher. Only turn off for local debugging on a throwaway DB.
DB_ENCRYPTION=true
# Blocks the recents-screen thumbnail from showing the money dashboard.
FLAG_SECURE=true

# ── Pipeline tuning ─────────────────────────────────────────────────
# Sequence-similarity floor for merging a message into a known template.
# Higher = more templates, more precise. Lower = over-merging. 0.62 was
# validated against a real HDFC/ICICI corpus; retune with the eval harness.
TEMPLATE_MERGE_RATIO=0.62
TEMPLATE_PREFIX_TOKENS=3
# Correlation: >= MERGE links to an existing entity, < ADJUDICATE_MIN
# creates a new one, and the band between asks Medha to decide.
LINK_MERGE_THRESHOLD=60
LINK_ADJUDICATE_MIN=30
# Window for the soft (merchant + amount) correlation key.
AMOUNT_WINDOW_HOURS=48
# Confidence below which a message goes to the review queue.
REVIEW_CONFIDENCE_FLOOR=0.55

# ── Locale ──────────────────────────────────────────────────────────
DEFAULT_CURRENCY=INR
DEFAULT_LOCALE=en-IN
# DMY is correct for India. Setting MDY will mis-parse 05-08-26.
DATE_ORDER=DMY
DEFAULT_TIMEZONE=Asia/Kolkata

# ── Development ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Retain messages that failed extraction, for the review queue.
DEBUG_KEEP_QUARANTINE=true
