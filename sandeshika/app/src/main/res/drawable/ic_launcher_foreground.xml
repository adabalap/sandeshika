<?xml version="1.0" encoding="utf-8"?>
<!--
  A prism separating light into a spectrum.

  The metaphor is the product: one undifferentiated stream of messages goes
  in, distinct categories come out. It replaces a stack of cards that said
  nothing more than "this app has messages in it", which every messaging app
  could claim.

  The three bars use the app's own category colours, so the icon is showing
  the actual thing the app does rather than an arbitrary rainbow.

  An earlier version drew the incoming beam too. It was dropped after
  rendering at true launcher size, where it read as a stray stub hanging off
  the triangle rather than as light entering it. The separation reads without
  it.

  Content stays within x,y in [18,98] of the 108 viewport, inside the
  adaptive-icon keyline.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <path android:pathData="M42,28 L66,76 L18,76 Z"
        android:strokeColor="#FFFFFFFF" android:strokeWidth="6.5"
        android:strokeLineJoin="round" android:fillColor="#00000000" />

    <path android:pathData="M75.75,36 h18.5 a3.75,3.75 0 0 1 0,7.5 h-18.5 a3.75,3.75 0 0 1 0,-7.5 z"
        android:fillColor="#FF4ADE80" />
    <path android:pathData="M75.75,48 h16.5 a3.75,3.75 0 0 1 0,7.5 h-16.5 a3.75,3.75 0 0 1 0,-7.5 z"
        android:fillColor="#FFF87171" />
    <path android:pathData="M75.75,60 h13.5 a3.75,3.75 0 0 1 0,7.5 h-13.5 a3.75,3.75 0 0 1 0,-7.5 z"
        android:fillColor="#FFC084FC" />
</vector>
