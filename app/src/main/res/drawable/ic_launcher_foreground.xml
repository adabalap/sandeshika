<?xml version="1.0" encoding="utf-8"?>
<!--
  Three message cards fanned into a sorted stack.

  The idea is "an inbox that has been put in order", which is the whole
  product in one image. The cards are staggered rather than aligned so the
  silhouette reads as a stack at a glance, and the top card carries a colour
  accent because the sorting is the point, not the messages.

  Saffron, distinct from Medha's indigo and the sample's teal, so the three
  apps are told apart instantly in a launcher.

  Content stays within x,y in [24,84] of the 108 viewport, inside the
  adaptive-icon keyline.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- back card -->
    <path android:pathData="M32,32 h44 a5,5 0 0 1 5,5 v8 a5,5 0 0 1 -5,5 h-44 a5,5 0 0 1 -5,-5 v-8 a5,5 0 0 1 5,-5 z"
        android:fillColor="#66FFFFFF" />
    <!-- middle card -->
    <path android:pathData="M28,50 h48 a5,5 0 0 1 5,5 v8 a5,5 0 0 1 -5,5 h-48 a5,5 0 0 1 -5,-5 v-8 a5,5 0 0 1 5,-5 z"
        android:fillColor="#B3FFFFFF" />
    <!-- front card, fully opaque, with a category accent bar -->
    <path android:pathData="M24,68 h52 a6,6 0 0 1 6,6 v9 a6,6 0 0 1 -6,6 h-52 a6,6 0 0 1 -6,-6 v-9 a6,6 0 0 1 6,-6 z"
        android:fillColor="#FFFFFFFF" />
    <path android:pathData="M24,68 h6 v21 h-6 a6,6 0 0 1 -6,-6 v-9 a6,6 0 0 1 6,-6 z"
        android:fillColor="#FF1B8A3A" />
    <path android:pathData="M36,74 h34 v3 h-34 z" android:fillColor="#33000000" />
    <path android:pathData="M36,81 h22 v3 h-22 z" android:fillColor="#22000000" />
</vector>
