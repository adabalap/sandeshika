    <string name="about_title">About Sandeshika</string>
    <string name="about_body">An SMS organiser that works entirely on this phone.\n\nMessages are read from your inbox, sorted by rules that run locally, and never uploaded. There is no account, no server, and no analytics.\n\nCategories you correct are remembered and used to teach a small model that also runs here.</string>
    <string name="about_privacy">Nothing leaves this device unless you explicitly share it.</string>
